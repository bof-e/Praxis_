# Backend Dockerfile pour Praxis
FROM python:3.11-slim

WORKDIR /app

# Installation des dépendances système pour psycopg2 et autres libs
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copie des requirements et installation des dépendances Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copie du code source
COPY src/ ./src/

# Exposition du port
EXPOSE 8000

# Lancement avec gunicorn + uvicorn worker pour la prod
CMD ["gunicorn", "src.api.main:app", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000"]
